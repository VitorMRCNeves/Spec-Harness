# Dependências do motor: só o `yaml` é dependência de runtime e vai versionado, para o plugin
# funcionar sem `npm install` na máquina de quem instala. O resto (typescript, @types) é de
# desenvolvimento e é instalado com `npm install` dentro de plugins/spec-harness/engine/.
plugins/spec-harness/engine/node_modules/*
!plugins/spec-harness/engine/node_modules/yaml/

# Python (ferramentas em engine/tools/)
__pycache__/
*.py[codz]
.pytest_cache/
.ruff_cache/
.coverage
coverage.json
htmlcov/

# Ambiente e editores
.env
.venv/
.DS_Store
